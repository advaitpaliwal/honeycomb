        android:strokeWidth="8.2"
        android:pathData="M54,31.5a22.5,22.5 0,1 0,0.01 0z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="38"
                android:startY="24"
                android:endX="72"
                android:endY="82">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.48" android:color="#FFDCDCE2" />
                <item android:offset="1.0" android:color="#FF9494A0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Subtle recessed inner bezel hairline -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="0.9"
        android:pathData="M54,39.5a14.5,14.5 0,1 0,0.01 0z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="39"
                android:endX="54"
                android:endY="69">
                <item android:offset="0.0" android:color="#59FFFFFF" />
                <item android:offset="1.0" android:color="#0AFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Drop shadow under center bullseye sphere -->
    <path
        android:fillColor="#99000000"
        android:pathData="M54,46.1a9.2,9.2 0,1 0,0.01 0z" />
    <!-- Sculpted pearl-white center bullseye -->
    <path android:pathData="M54,44.8a9.2,9.2 0,1 0,0.01 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="51.6"
                android:centerY="50.8"
                android:gradientRadius="12">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.65" android:color="#FFE4E4EA" />
                <item android:offset="1.0" android:color="#FF9A9AA6" />
            </gradient>
        </aapt:attr>
    </path>
