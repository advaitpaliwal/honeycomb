<?xml version="1.0" encoding="utf-8"?>
<!-- Feedcut's accessibility_config.xml (Apache-2.0), with every package watched so the pause knows when a feed app opens. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged|typeViewScrolled|typeViewClicked|typeViewSelected"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canPerformGestures="false"
    android:canRetrieveWindowContent="true"
    android:description="@string/feed_guard_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100" />
