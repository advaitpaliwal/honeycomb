<?xml version="1.0" encoding="utf-8"?>
<!-- Fixture row: its content is 30dp tall, centred, the way a widget lays out inside whatever height it is given. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:background="#FFFA2D48"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:layout_width="match_parent" android:layout_height="30dp" android:layout_gravity="center"
        android:contentDescription="fixture-content" android:gravity="center" android:text="row 30dp"
        android:textColor="#FFFFFFFF" android:background="#FFFA2D48" />
</FrameLayout>
