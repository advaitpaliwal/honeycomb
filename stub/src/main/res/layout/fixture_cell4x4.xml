<?xml version="1.0" encoding="utf-8"?>
<!-- Fixture cell4x4: its content is 250dp tall, centred, the way a widget lays out inside whatever height it is given. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:background="#FF9334E6"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:layout_width="match_parent" android:layout_height="250dp" android:layout_gravity="center"
        android:contentDescription="fixture-content" android:gravity="center" android:text="cell4x4 250dp"
        android:textColor="#FFFFFFFF" android:background="#FF9334E6" />
</FrameLayout>
